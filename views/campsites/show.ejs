<%- include("../partials/header", {stylesheets: ['/stylesheets/show.css']}) %>
<%
  const facility = data.recData
  const media = data.mediaData ?? []
  // A video URL is no use in an <img>, so the gallery takes images only, the
  // primary one first. Anything else is listed as a link.
  const images = media.filter((item) => item.MediaType === 'Image')
  const primaryAt = images.findIndex((item) => item.IsPrimary)
  if (primaryAt > 0) images.unshift(...images.splice(primaryAt, 1))
  // escaping stops markup, not a javascript: URL, so links must be http(s).
  const isWebUrl = (url) => /^https?:\/\//i.test(url ?? '')
  const videos = media.filter((item) => item.MediaType !== 'Image' && isWebUrl(item.URL))
  const links = (data.linksData ?? []).filter((link) => isWebUrl(link.URL))

  const recAreaName = data.parentRecArea.RecAreaName
  const [lng, lat] = facility.GEOJSON.COORDINATES
  const degrees = (value) => `${Number(value).toFixed(4)}°`.replace('-', '−')
  const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`

  // Sanitized in the show route. Each shows only when it has content.
  const sections = [
    {label: 'OVERVIEW', html: facility.FacilityDescription},
    {label: 'DIRECTIONS', html: facility.FacilityDirections},
    {label: 'FEES', html: facility.FacilityUseFeeDescription},
  ].filter((section) => section.html.trim())

  const comments = foundCampsite.comments
  // A fixed locale and time zone, so the date doesn't depend on the server.
  const dateFormat = new Intl.DateTimeFormat('en-US', {dateStyle: 'medium', timeZone: 'UTC'})
  // Comments from before 2023-06-22 have no createdAt, and mongoose fills in
  // today as it loads them. Their ObjectId holds when they were made.
  // A null or broken createdAt gets the same fallback.
  const madeAt = (comment) => {
    const {createdAt} = comment
    const valid = createdAt instanceof Date && !Number.isNaN(createdAt.getTime())
    return valid && !comment.$isDefault('createdAt') ? createdAt : comment._id.getTimestamp()
  }
%>

<header class="detail-hero camo">
  <a class="detail-hero__back" href="/campsites">← BACK TO CAMPSITES</a>
  <div class="detail-hero__row">
    <div class="detail-hero__title">
      <% if (facility.FacilityTypeDescription || foundCampsite.state) { %>
      <div class="detail-hero__tags">
        <% if (facility.FacilityTypeDescription) { %>
        <span class="tag"><%= facility.FacilityTypeDescription %></span>
        <% } %>
        <% if (foundCampsite.state) { %>
        <span class="tag tag--plain"><%= foundCampsite.state %></span>
        <% } %>
      </div>
      <% } %>
      <h1 class="detail-hero__name"><%= facility.FacilityName %></h1>
      <% if (recAreaName) { %>
      <p class="detail-hero__place">Located in <strong><%= recAreaName %></strong></p>
      <% } %>
    </div>
    <div class="detail-hero__actions">
      <% if (currentUser && !favorite) { %>
      <form
        class="detail-hero__favorite"
        action="/user/<%= currentUser._id %>/<%= foundCampsite.id %>/"
        method="POST"
      >
        <button class="button" type="submit">+ Add favorite</button>
      </form>
      <% } %>
      <a class="button button--outline" href="#comments">Comments (<%= comments.length %>)</a>
    </div>
  </div>
</header>

<% if (images.length) { %>
<section
  class="detail-gallery detail-gallery--<%= Math.min(images.length, 3) %>"
  aria-label="Photos"
  data-gallery
>
  <div class="detail-gallery__main">
    <% images.forEach((image, i) => { %>
    <figure class="detail-gallery__figure" data-gallery-figure <%= i ? 'hidden' : '' %>>
      <img
        class="detail-gallery__image"
        src="<%= image.URL %>"
        alt="<%= image.Description || image.Title || `Photo of ${facility.FacilityName}` %>"
        <% if (image.Width && image.Height) { %>width="<%= image.Width %>" height="<%= image.Height %>"<% } %>
        <% if (i) { %>loading="lazy"<% } else { %>fetchpriority="high"<% } %>
        data-gallery-slide
      />
      <figcaption class="detail-gallery__caption"><%= image.Title %></figcaption>
    </figure>
    <% }) %>
    <% if (images.length > 1) { %>
    <div class="detail-gallery__controls" data-gallery-controls hidden>
      <button class="detail-gallery__step" type="button" data-gallery-prev><span aria-hidden="true">←</span> PREV</button>
      <span class="detail-gallery__counter" aria-live="polite" data-gallery-counter>01 / <%= String(images.length).padStart(2, '0') %></span>
      <button class="detail-gallery__step" type="button" data-gallery-next>NEXT <span aria-hidden="true">→</span></button>
    </div>
    <% } %>
  </div>
  <% images.slice(1, 3).forEach((image, i) => { %>
  <% const more = i === 1 ? images.length - 3 : 0 %>
  <button
    class="detail-gallery__thumb"
    type="button"
    aria-label="Show photo <%= i + 2 %> of <%= images.length %><%= more ? `, +${more} more` : '' %>"
    data-gallery-goto="<%= i + 1 %>"
  >
    <img class="detail-gallery__image" src="<%= image.URL %>" alt="" loading="lazy" />
    <% if (more) { %>
    <span class="detail-gallery__more">+<%= more %> more</span>
    <% } %>
  </button>
  <% }) %>
</section>
<% } %>

<% const hasSections = sections.length || videos.length %>
<div class="detail-layout<%= hasSections ? '' : ' detail-layout--no-sections' %>">
  <% if (hasSections) { %>
  <div class="detail-sections">
    <% for (const section of sections) { %>
    <section class="detail-section">
      <h2 class="section-label detail-section__label"><%= section.label %></h2>
      <%# Unescaped on purpose: sanitized in the show route. %>
      <div class="detail-prose"><%- section.html %></div>
    </section>
    <% } %>
    <% if (videos.length) { %>
    <section class="detail-section">
      <h2 class="section-label detail-section__label">VIDEOS</h2>
      <ul class="detail-videos">
        <% for (const video of videos) { %>
        <li><a href="<%= video.URL %>"><%= video.Title || 'Video' %> (video) →</a></li>
        <% } %>
      </ul>
    </section>
    <% } %>
  </div>
  <% } %>

  <aside class="detail-aside">
    <section class="detail-card" aria-labelledby="map-label">
      <h2 class="section-label detail-card__label" id="map-label">CAMP MAP</h2>
      <div id="map"
        data-lat="<%= lat %>"
        data-lng="<%= lng %>"
        data-name="<%= facility.FacilityName %>"
        data-map-id="<%= mapsMapId %>"
        data-maps-key="<%= mapsKey %>"></div>
      <dl class="detail-coords">
        <div>
          <dt>LATITUDE</dt>
          <dd><%= degrees(lat) %></dd>
        </div>
        <div>
          <dt>LONGITUDE</dt>
          <dd><%= degrees(lng) %></dd>
        </div>
      </dl>
      <a class="detail-card__action" href="<%= directionsUrl %>">Open directions →</a>
    </section>

    <% if (links.length) { %>
    <section class="detail-card detail-links" aria-labelledby="links-label">
      <h2 class="section-label" id="links-label">MORE INFO &amp; LINKS</h2>
      <ul class="detail-links__list">
        <% for (const link of links) { %>
        <li>
          <a class="detail-links__link" href="<%= link.URL %>">
            <span class="detail-links__title"><%= link.Title %> →</span>
            <% if (link.Description && link.Description !== link.Title) { %>
            <span class="detail-links__description"><%= link.Description %></span>
            <% } %>
          </a>
        </li>
        <% } %>
      </ul>
    </section>
    <% } %>
  </aside>

  <section class="detail-comments" id="comments" aria-labelledby="comments-heading">
    <div class="detail-comments__head">
      <h2 class="detail-comments__heading" id="comments-heading">Comments</h2>
      <span class="meta"><%= comments.length %> FROM THE FIELD</span>
    </div>

    <% if (comments.length) { %>
    <ol class="detail-comments__list">
      <% for (const comment of comments) { %>
      <% const made = madeAt(comment) %>
      <li class="detail-comment">
        <span class="detail-comment__initial" aria-hidden="true"><%= (comment.author.username || '?').charAt(0) %></span>
        <div class="detail-comment__body">
          <div class="detail-comment__head">
            <span class="detail-comment__user"><%= comment.author.username %></span>
            <time class="detail-comment__date" datetime="<%= made.toISOString() %>"><%= dateFormat.format(made) %></time>
          </div>
          <p class="detail-comment__text"><%= comment.text %></p>
          <% if (currentUser && comment.author.id && comment.author.id.equals(currentUser._id)) { %>
          <div class="detail-comment__actions">
            <a
              class="detail-comment__edit"
              href="/campsites/<%= foundCampsite.id %>/comments/<%= comment._id %>/edit"
              >EDIT</a
            >
            <form
              class="detail-comment__delete-form"
              action="/campsites/<%= foundCampsite.id %>/comments/<%= comment._id %>?_method=DELETE"
              method="POST"
            >
              <button class="detail-comment__delete" type="submit">DELETE</button>
            </form>
          </div>
          <% } %>
        </div>
      </li>
      <% } %>
    </ol>
    <% } %>

    <% if (currentUser) { %>
    <form
      class="detail-comment-form validated-form"
      action="/campsites/<%= foundCampsite.id %>/comments"
      method="POST"
      novalidate
    >
      <label class="detail-visually-hidden" for="comment-text">Your comment</label>
      <textarea
        class="input detail-comment-form__input"
        id="comment-text"
        name="comment[text]"
        placeholder="Share a tip about this campsite…"
        minlength="10"
        maxlength="300"
        required
      ></textarea>
      <span class="field__error detail-comment-form__error">Write between 10 and 300 characters.</span>
      <div class="detail-comment-form__bar">
        <span class="detail-comment-form__who">POSTING AS <%= currentUser.username %></span>
        <button class="button detail-comment-form__submit" type="submit">Add comment</button>
      </div>
    </form>
    <% } else { %>
    <p class="detail-comments__login"><a href="/login">Log in to comment</a></p>
    <% } %>
  </section>
</div>

<% if (currentUser) { %>
<script src="/js/validateForms.js"></script>
<% } %>
<% if (images.length > 1) { %>
<script src="/js/gallery.js" defer></script>
<% } %>
<script src="/js/gmapLoader.js"></script>
<script src="/js/gmap.js"></script>
<script
  async
  src="//embedr.flickr.com/assets/client-code.js"
  charset="utf-8"
></script>

<%- include("../partials/footer") %>
