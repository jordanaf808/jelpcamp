<%- include("../partials/header", {stylesheets: ['/stylesheets/campsites.css']}) %>

<header class="landing-hero camo">
  <div class="landing-hero__text">
    <p class="eyebrow">Welcome to WANDUR.</p>
    <h1 class="landing-hero__title">Find a new adventure.</h1>
    <p class="landing-hero__intro">
      Use the Keyword, Activity, and/or State option to help you find the right
      adventure, or select a facility from the map below! Sign up to save your
      favorites and share your comments!
    </p>
  </div>
  <%- include("../partials/searchForm") %>
</header>

<div class="landing-notes">
  <p>Test login — user: <span class="landing-notes__value">elmer</span> | password: <span class="landing-notes__value">fudd</span></p>
  <p>Source: Recreation Information Database (R.I.D.B.)</p>
</div>

<%- include("../partials/campsiteMap") %>

<%
  const meta = [searchParams.query, searchParams.state, 'sorted by date']
    .filter((part) => typeof part === 'string' && part !== '')
  meta.push(`${recData.length} ${recData.length === 1 ? 'result' : 'results'}`)
%>
<section class="facility-list" aria-labelledby="facility-list-title">
  <div class="facility-list__head">
    <h2 class="facility-list__title" id="facility-list-title">Search results</h2>
    <p class="facility-list__meta"><%= meta.join(' · ') %></p>
  </div>
  <% if (recData.length) { %>
  <div class="facility-grid">
    <% for (const facility of recData) { %>
    <%- include("../partials/facilityCard", {facility}) %>
    <% } %>
  </div>
  <% } else { %>
  <p class="facility-list__empty">No facilities with a location match this search. Try another keyword, activity or state.</p>
  <% } %>
</section>

<%- include("../partials/footer") %>
