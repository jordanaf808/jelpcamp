<%- include("../partials/header", {stylesheets: ['/stylesheets/account.css']}) %>

<div class="account-hero camo">
  <div class="account-hero__inner">
    <div class="account-hero__who">
      <div class="account-hero__tile" aria-hidden="true"><%= [...user.username][0] %></div>
      <div class="account-hero__name">
        <span class="eyebrow">Profile</span>
        <h1 class="account-hero__title"><%= user.username %></h1>
      </div>
    </div>
    <div class="account-stats">
      <div class="account-stat">
        <span class="account-stat__value"><%= user.favorites.length %></span>
        <span class="account-stat__label">Favorites</span>
      </div>
      <div class="account-stat">
        <span class="account-stat__value"><%= commentCount %></span>
        <span class="account-stat__label">Comments</span>
      </div>
    </div>
  </div>
</div>

<section class="account-body" aria-labelledby="favorites-heading">
  <div class="account-body__head">
    <h2 class="account-body__title" id="favorites-heading">My favorite campgrounds</h2>
    <% if (user.favorites.length > 0) { %>
    <a class="account-body__more" href="/campsites">Find more campsites →</a>
    <% } %>
  </div>

  <% if (user.favorites.length === 0) { %>
  <div class="account-empty">
    <p class="account-empty__text">You haven't saved any campgrounds yet.</p>
    <a class="button" href="/campsites">Find campsites →</a>
  </div>
  <% } else { %>
  <table class="account-table">
    <thead>
      <tr>
        <th scope="col" class="account-table__no">No.</th>
        <th scope="col" class="account-table__name">Facility name</th>
        <th scope="col" class="account-table__area">Located in</th>
        <th scope="col" class="account-table__state">State</th>
        <th scope="col" class="account-table__actions"><span class="account-visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% user.favorites.forEach((favorite, index) => { %>
      <tr class="account-row">
        <td class="account-row__no"><%= index + 1 %></td>
        <th scope="row" class="account-row__name"><%= favorite.name %></th>
        <td class="account-row__area"><%= favorite.recAreaName || '—' %></td>
        <td class="account-row__state"><%= favorite.state || '—' %></td>
        <td class="account-row__actions">
          <div class="account-row__buttons">
            <a class="button button--outline button--sm" href="/campsites/show/<%= favorite.id %>">More info →</a>
            <form action="/user/<%= user.id %>/<%= favorite.id %>?_method=DELETE" method="POST">
              <button class="button button--danger button--sm" type="submit">
                Remove<span class="account-visually-hidden"> <%= favorite.name %> from favorites</span>
              </button>
            </form>
          </div>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
</section>

<%- include("../partials/footer") %>
