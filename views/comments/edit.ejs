<%- include("../partials/header", {stylesheets: ['/stylesheets/account.css']}) %>

<div class="account-page">
  <div class="account-card account-card--wide">
    <span class="eyebrow">Edit comment</span>
    <h1 class="account-card__title">Edit <%= comment.author.username %>'s comment</h1>

    <form
      class="account-form validated-form"
      action="/campsites/<%= campsite_id %>/comments/<%= comment._id %>?_method=PUT"
      method="POST"
      novalidate
    >
      <div class="field">
        <label class="field__label" for="comment-text">Comment</label>
        <textarea class="input" id="comment-text" name="comment[text]" rows="5" minlength="10" maxlength="300" required><%= comment.text %></textarea>
        <span class="field__error">Write 10 to 300 characters.</span>
      </div>
      <div class="account-form__actions">
        <button class="button" type="submit">Save comment</button>
        <a class="account-form__cancel" href="/campsites/show/<%= campsite_id %>">Cancel</a>
      </div>
    </form>
  </div>
</div>
<script src="/js/validateForms.js"></script>
<%- include("../partials/footer") %>
