<%- include("../partials/header", {stylesheets: ['/stylesheets/account.css']}) %>

<div class="account-page">
  <div class="account-card account-card--wide">
    <span class="eyebrow">New comment</span>
    <h1 class="account-card__title">Add a comment to <%= campsite.name %></h1>

    <form class="account-form validated-form" action="/campsites/<%= campsite.id %>/comments/" method="POST" novalidate>
      <div class="field">
        <label class="field__label" for="comment-text">Comment</label>
        <textarea class="input" id="comment-text" name="comment[text]" rows="5" minlength="10" maxlength="300" required></textarea>
        <span class="field__error">Write 10 to 300 characters.</span>
      </div>
      <div class="account-form__actions">
        <button class="button" type="submit">Submit comment</button>
        <a class="account-form__cancel" href="/campsites/show/<%= campsite.id %>">Cancel</a>
      </div>
    </form>
  </div>
</div>
<script src="/js/validateForms.js"></script>
<%- include("../partials/footer") %>
