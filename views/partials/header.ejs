<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>WANDUR · Public Lands Finder</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <% if (typeof mapBox !== 'undefined' && mapBox) { %>
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.30.0/mapbox-gl.js" crossorigin="anonymous" defer></script>
    <link
      rel="stylesheet"
      href="https://api.mapbox.com/mapbox-gl-js/v3.30.0/mapbox-gl.css"
      crossorigin="anonymous"
    />
    <% } %>
    <link rel="stylesheet" href="/stylesheets/wandur.css" />
    <%# A view adds its own: include("../partials/header", {stylesheets: [...]}) %>
    <% for (const href of locals.stylesheets || []) { %>
    <link rel="stylesheet" href="<%= href %>" />
    <% } %>
    <script src="/js/nav.js" defer></script>
    <script src="/js/flash.js" defer></script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-nav" data-site-nav>
      <a class="site-nav__brand" href="/campsites">
        <span class="site-nav__logo">WANDUR</span>
        <span class="site-nav__tagline">PUBLIC LANDS FINDER</span>
      </a>
      <button
        class="site-nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-nav-toggle
      >
        Menu
      </button>
      <nav class="site-nav__menu" id="site-menu" aria-label="Main">
        <a class="site-nav__link" href="/campsites" data-nav-link>Campsites</a>
        <% if (!currentUser) { %>
        <a class="site-nav__link" href="/login" data-nav-link>Login</a>
        <a class="site-nav__cta" href="/register">Register</a>
        <% } else { %>
        <a class="site-nav__link" href="/user/<%= currentUser._id %>" data-nav-link><%= currentUser.username %>'s favorites</a>
        <a class="site-nav__link" href="/logout">Logout</a>
        <% } %>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <%
        // A route can pass `error` itself (register does, as a string), so
        // either shape becomes a list of messages here.
        const flashes = [
          ...[].concat(locals.error || []).map((text) => ({type: 'error', text})),
          ...[].concat(locals.success || []).map((text) => ({type: 'success', text})),
        ]
      %>
      <% if (flashes.length) { %>
      <div class="flash-list" data-flash-list>
        <% for (const flash of flashes) { %>
        <div class="flash flash--<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
          <p class="flash__text"><%= flash.text %></p>
          <button class="flash__close" type="button" aria-label="Dismiss message" data-flash-dismiss>&times;</button>
        </div>
        <% } %>
      </div>
      <% } %>
