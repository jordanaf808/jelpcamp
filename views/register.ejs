<%- include("./partials/header", {stylesheets: ['/stylesheets/account.css']}) %>

<div class="account-page">
  <div class="account-card">
    <span class="eyebrow">Join WANDUR</span>
    <h1 class="account-card__title">Sign up</h1>

    <form class="account-form validated-form" action="/register" method="POST" novalidate>
      <div class="field">
        <label class="field__label" for="username">Username</label>
        <input class="input" type="text" id="username" name="username" maxlength="20" autocomplete="username" required />
        <span class="field__error">Choose a username, 20 characters at most.</span>
      </div>
      <div class="field">
        <label class="field__label" for="password">Password</label>
        <input class="input" type="password" id="password" name="password" minlength="3" maxlength="20" autocomplete="new-password" required />
        <span class="field__error">Choose a password of 3 to 20 characters.</span>
      </div>
      <button class="button" type="submit">Register</button>
    </form>

    <p class="account-card__alt">Already have an account? <a href="/login">Login</a></p>
  </div>
</div>
<script src="/js/validateForms.js"></script>
<%- include("./partials/footer") %>
